# Flame in Freefall - Environment Configuration Example
# Copy this file to .env and configure as needed:
# cp .env.example .env

# FastAPI Server Network Configuration
API_HOST=127.0.0.1
API_PORT=8000

# Google Gemini API Key (Optional)
# If provided, enables live generative responses in the AI Research Assistant.
# If omitted or quota-exhausted, the application seamlessly runs in Local Evidence Mode (zero API key needed).
GEMINI_API_KEY=your_gemini_api_key_here
