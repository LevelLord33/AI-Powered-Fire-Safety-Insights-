"""
Configuration settings for the Flame in Freefall FastAPI backend.
Manages CORS origins, file paths, and secure credential handling.
"""

import os
from pathlib import Path
from typing import List

# Base workspace path
BASE_DIR = Path(__file__).resolve().parent.parent

# Data paths
DATA_DIR = BASE_DIR / "data"
PROCESSED_DATA_DIR = DATA_DIR / "processed"
DOCS_DIR = DATA_DIR / "docs"
RAW_DATA_DIR = DATA_DIR / "raw"

EXPERIMENTS_CSV_PATH = PROCESSED_DATA_DIR / "bass_ii_experiments.csv"
SEARCH_INDEX_JSON_PATH = PROCESSED_DATA_DIR / "search_index.json"
SUMMARY_PDF_PATH = DOCS_DIR / "bass_ii_summary_report.pdf"
FLEX_EXPERIMENTS_CSV_PATH = PROCESSED_DATA_DIR / "flex_experiments.csv"
FLEX_PDF_PATH = DOCS_DIR / "FLEX_EIRD_v4.pdf"

# FastAPI server network settings
HOST = os.getenv("API_HOST", "127.0.0.1")
PORT = int(os.getenv("API_PORT", "8000"))

# Allowed CORS origins for local development (React Vite default is 5173)
CORS_ORIGINS: List[str] = [
    "http://localhost:5173",
    "http://127.0.0.1:5173",
    "http://localhost:3000",
    "http://127.0.0.1:3000",
    "http://localhost:8501",  # Streamlit parallel preview
]

