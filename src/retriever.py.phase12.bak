"""
Retrieval engine for NASA BASS-II research evidence.
Uses TF-IDF vectorization and cosine similarity scoring with domain keyword boosting.
Ensures strict relevance thresholds so unsupported questions do not return false matches.
"""

import logging
import re
from typing import Any, Dict, List
import numpy as np
from sklearn.feature_extraction.text import TfidfVectorizer
from sklearn.metrics.pairwise import cosine_similarity
from src.document_processor import DocumentProcessor

logger = logging.getLogger(__name__)

# Key combustion and NASA mission domain terms that warrant relevance boosting
DOMAIN_KEYWORDS = {
    "combustion",
    "flame",
    "fire",
    "microgravity",
    "bass",
    "bass-ii",
    "iss",
    "glovebox",
    "msg",
    "oxygen",
    "o2",
    "airflow",
    "velocity",
    "extinction",
    "quench",
    "spread",
    "ignition",
    "pmma",
    "sibal",
    "nomex",
    "carbon",
    "monoxide",
    "co",
    "co2",
    "bhattacharjee",
    "ferkul",
    "olson",
    "tien",
    "miller",
    "fernandez-pello",
    "opposed",
    "concurrent",
    "stagnation",
    "flammability",
    "smoke",
    "buoyancy",
    "freefall",
}


class NASARetriever:
    """Lightweight, reliable evidence retrieval system for NASA BASS-II documents."""

    def __init__(self, document_processor: DocumentProcessor = None):
        if document_processor is None:
            self.dp = DocumentProcessor()
        else:
            self.dp = document_processor

        self.chunks: List[Dict[str, Any]] = []
        self.vectorizer: TfidfVectorizer = None
        self.tfidf_matrix = None
        self._initialize_index()

    def _initialize_index(self):
        """Load or build document chunks and fit TF-IDF vectorizer."""
        self.chunks = self.dp.build_or_load_index()
        if not self.chunks:
            logger.warning("No document chunks available for retrieval index.")
            return

        corpus = [c["content"] for c in self.chunks]
        self.vectorizer = TfidfVectorizer(
            ngram_range=(1, 2),
            stop_words="english",
            max_df=0.85,
            min_df=1,
            sublinear_tf=True,
        )
        self.tfidf_matrix = self.vectorizer.fit_transform(corpus)
        logger.info(
            f"NASARetriever initialized with {len(self.chunks)} chunks."
        )

    def retrieve(
        self,
        query: str,
        top_k: int = 4,
        min_raw_score: float = 0.08,
        min_final_score: float = 0.12,
    ) -> List[Dict[str, Any]]:
        """Search NASA documents for the most relevant evidence passages.

        Args:
            query: User search or question string.
            top_k: Maximum number of passages to return.
            min_raw_score: Minimum baseline TF-IDF cosine similarity.
            min_final_score: Minimum boosted score to qualify as supporting evidence.

        Returns:
            List of passage dictionaries ranked by relevance.
        """
        if not query or not query.strip():
            return []

        if self.tfidf_matrix is None or not self.chunks:
            self._initialize_index()
            if self.tfidf_matrix is None:
                return []

        # 1. Compute cosine similarity with TF-IDF
        query_vec = self.vectorizer.transform([query])
        raw_scores = cosine_similarity(query_vec, self.tfidf_matrix).flatten()

        # 2. Extract query keywords
        query_words = set(re.findall(r"\w+", query.lower()))
        domain_matches = query_words.intersection(DOMAIN_KEYWORDS)

        final_scores = np.copy(raw_scores)

        for idx, chunk in enumerate(self.chunks):
            # Only boost if chunk already has non-trivial baseline lexical similarity
            if raw_scores[idx] >= min_raw_score:
                content_lower = chunk["content"].lower()
                # Boost if domain keywords match
                match_count = sum(1 for kw in domain_matches if kw in content_lower)
                final_scores[idx] += 0.05 * match_count

        # 3. Sort by relevance
        ranked_indices = np.argsort(final_scores)[::-1]

        results = []
        for idx in ranked_indices:
            score = float(final_scores[idx])
            # Strict threshold to reject completely irrelevant questions
            if score < min_final_score or raw_scores[idx] < min_raw_score:
                continue

            chunk_data = dict(self.chunks[idx])
            chunk_data["relevance_score"] = round(score, 4)
            chunk_data["raw_tfidf_score"] = round(float(raw_scores[idx]), 4)
            results.append(chunk_data)
            if len(results) >= top_k:
                break

        return results

    def get_source_statistics(self) -> Dict[str, Any]:
        """Return counts of indexed chunks and available source files."""
        stats = {
            "total_chunks": len(self.chunks),
            "sources": {},
            "sources_verified": self.dp.verify_sources(),
        }
        for c in self.chunks:
            src = c.get("source_file", "unknown")
            stats["sources"][src] = stats["sources"].get(src, 0) + 1
        return stats
